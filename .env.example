# ─────────────────────────────────────────────────
# SenVerbalis — Variables d'environnement
# Copiez ce fichier : cp .env.example backend/.env
# ─────────────────────────────────────────────────

# ── Base de données PostgreSQL ────────────────────
DB_USER=senverbalis_user
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_securise
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senverbalis

# Alternative : URL complète (prioritaire si définie)
# DATABASE_URL=postgresql://senverbalis_user:motdepasse@localhost:5432/senverbalis
# Pour le développement avec SQLite :
# DATABASE_URL=sqlite:///./senverbalis.db

# ── JWT ───────────────────────────────────────────
# Générez une clé sécurisée : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGEZ_MOI_cle_jwt_securisee_64_caracteres_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# ── Cryptographie & Intégrité Serveur ──────────────
# Clé de chiffrement AES interne du serveur (AES-GCM-256)
SERVER_AES_KEY=CHANGEZ_MOI_cle_serveur_aes_securisee_32_caracteres
# Clé de signature HMAC-SHA256 pour l'infaillibilité des PV
SERVER_HMAC_KEY=CHANGEZ_MOI_cle_serveur_hmac_securisee_32_caracteres

